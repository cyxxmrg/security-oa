# ============================================
# OA Docker 部署 - 环境变量模板
# 复制成 .env 后填入真实值
# ============================================

# 主机端口
WEB_PORT=80

# 镜像源 (1=阿里云, 2=腾讯云, 3=默认 docker hub)
MIRROR=1

# ============== 数据库 ==============
DB_DATABASE=security_oa
DB_USERNAME=oa_user
# 随机生成: openssl rand -base64 24 | tr -d '/+=' | head -c 24
DB_PASSWORD=CHANGEME_DB_PASSWORD

# ============== Redis ==============
# 随机生成: openssl rand -base64 24 | tr -d '/+=' | head -c 24
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD

# ============== Laravel ==============
# 随机生成: APP_KEY="base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGEME_APP_KEY
APP_URL=http://192.168.1.115
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stack

# ============== 首次安装开关 ==============
# OA_FRESH_INSTALL=1: 跑 seed + PermissionRoleSeeder + disk-init
# OA_AUTO_SEED=0   : 不重跑
OA_FRESH_INSTALL=1
OA_AUTO_SEED=0

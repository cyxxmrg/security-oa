APP_NAME="安防运维OA"
APP_ENV=local
APP_KEY=
# ⚠️ 生产环境务必改为 false，否则错误信息会暴露 SQL/路径/堆栈
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ⚠️ 生产必须用 PostgreSQL (OA 系统依赖 PG 的 JSONB / window function / DBLINK)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=security_oa
DB_USERNAME=oa_user
DB_PASSWORD=

BROADCAST_DRIVER=log
# ⚠️ 生产建议改为 redis (file 驱动在并发下有 IO 瓶颈, 且不利于多机部署)
# Laravel 11 实际读取 CACHE_STORE (旧键 CACHE_DRIVER 已废弃); 二者并存以兼容
CACHE_STORE=redis
CACHE_DRIVER=redis
# 默认 local (私有 disk), 公开附件上传走 public disk (注意 security)
FILESYSTEM_DISK=local
# ⚠️ 生产建议改为 redis (database 队列有锁竞争)
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,oa.afjsw.cn
SESSION_DOMAIN=localhost

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== V1.2.7 P2-3 性能监控阈值 (毫秒) =====
OA_WARN_MS=200      # 偏慢, debug 记
OA_SLOW_MS=500      # 慢, ErrorReporter warn
OA_CRITICAL_MS=1000 # 严重, dispatch 告警 Job
OA_LOG_API=false    # 是否记每个 API 请求 (开发 true, 生产 false)

# ===== V1.2.7 P2-3 慢接口告警 webhook =====
# 不配置就只写日志, 不发推送; 配置钉钉/企业微信 webhook URL 即可
# SLOW_ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
SLOW_ALERT_WEBHOOK_URL=

# ===== V1.2.7 P2-1 Horizon 路径 =====
HORIZON_PATH=horizon
# 生产配域名避免公网访问, dev 留空
# HORIZON_DOMAIN=horizon.oa.afjsw.cn

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"